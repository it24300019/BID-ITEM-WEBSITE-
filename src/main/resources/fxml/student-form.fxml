<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="10" style="-fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.usermanagement.controller.JavaFxStudentController">
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Student Management System" textAlignment="JUSTIFY">
         <font>
            <Font name="System Bold" size="28.0" />
         </font></Label>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="80" text="Student ID:" />
            <TextField fx:id="txtStudentId" prefWidth="200" promptText="Enter student ID (numbers only)">
            <font>
               <Font size="13.0" />
            </font></TextField>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="80" text="Name:" />
            <TextField fx:id="txtName" prefWidth="200" promptText="Enter student full name" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label minWidth="80" text="Age:" />
            <TextField fx:id="txtAge" prefWidth="200" promptText="&quot;Enter age (18-99)" />
        </HBox>
      <DatePicker id="dtpRegistrationDate" promptText="Select registration date" />
      <ComboBox id="cmbStatus" prefWidth="150.0" promptText="Select status" />

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button fx:id="btnSubmit" onAction="#handleSubmit" prefWidth="80" text="💾 Save Student" />
            <Button fx:id="btnLoad" onAction="#handleLoad" prefWidth="120" text="Load All Students" />
        </HBox>

        <Label text="Output:" />
        <TextArea fx:id="txtOutput" prefHeight="150" wrapText="true" />
    </children>
</VBox>
